# Server Network & Runtime Configuration
PORT=8200
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Master Key Encryption Key (KEK) - 256-bit Hex String (64 hex chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCLAVE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL="postgresql://enclave_user:enclave_secure_password@localhost:5432/enclave_db?schema=public"

# Role-Based Access Control (RBAC) Service Identity Policies (JSON Array)
ENCLAVE_RBAC_POLICIES='[{"serviceId":"billing-service","token":"billing-secret-token","clientCertCn":"billing-service.internal","allowedKeyAliases":["*"],"allowedOperations":["*"]}]'
